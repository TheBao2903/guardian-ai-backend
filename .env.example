# Guardian AI Backend Configuration Template
# Sao chép file này thành .env và điền các giá trị thực tế

# ===========================================
# TELEGRAM NOTIFICATION (Bot Token)
# ===========================================
# Lấy từ Telegram BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ===========================================
# STORAGE (Cloudflare R2 / AWS S3 Compatible)
# ===========================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY=your_cloudflare_r2_access_key
R2_SECRET_KEY=your_cloudflare_r2_secret_key
R2_BUCKET=guardian-ai
R2_PUBLIC_URL=https://pub-yourbucket.r2.dev

# ===========================================
# CORS
# ===========================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080","*"]

# ===========================================
# FIREBASE CONFIGURATION
# ===========================================
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
# Cách 1 (Khuyến nghị khi deploy Render qua Secret Files):
FIREBASE_CREDENTIALS_PATH=/etc/secrets/firebase-service-account.json
# Cách 2 (Hoặc dán toàn bộ nội dung file JSON vào 1 biến môi trường):
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}

